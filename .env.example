# ========================================================
# CẤU HÌNH DATABASE
# ========================================================
DB_USER_MYSQL=root
DB_PASSWORD_MYSQL=
DB_HOST_MYSQL=127.0.0.1
DB_PORT_MYSQL=3306
DB_NAME=ecommerce
DB_PARAMS=parseTime=true&loc=Local

# ========================================================
# CẤU HÌNH JWT (JSON Web Token)
# ========================================================
# Khóa bí mật dùng để mã hoá/giải mã token đăng nhập
JWT_SECRET=your_jwt_secret_key_here

# ========================================================
# CẤU HÌNH OAUTH2 (Google & Facebook Login)
# ========================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ========================================================
# CẤU HÌNH GỬI EMAIL (SMTP)
# ========================================================
# Khuyên dùng Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@gmail.com
SMTP_FROM_NAME="KC Tech"

# Thời gian sống của mã OTP (phút)
OTP_EXPIRE_MINUTES=3
